# Kimi by KAHF Capital — environment variables.
# Copy to .env.local for development. Never commit real values.
# See docs/kimi/README.md for what each one does.

# --- Messaging -------------------------------------------------------------
# sendblue (iMessage with SMS fallback) or twilio (SMS)
MESSAGING_PROVIDER=sendblue
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
# Signing secret from the Sendblue webhook settings
SENDBLUE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER is accepted as an alias
TWILIO_FROM_NUMBER=
# Optional: send through the Messaging Service registered to your A2P 10DLC campaign
TWILIO_MESSAGING_SERVICE_SID=

# --- LLM -------------------------------------------------------------------
KIMI_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
KIMI_MODEL=claude-sonnet-5-5
KIMI_FAST_MODEL=claude-haiku-5-5
# Existing site model; Kimi falls back to it if KIMI_MODEL is unavailable
ANTHROPIC_MODEL=

# --- Alerts ----------------------------------------------------------------
# Signals older than this when Kimi first sees them are suppressed as stale
KIMI_MAX_SIGNAL_AGE_MINUTES=15
# Master switch for proactive alerts (the admin kill switch can also turn them off)
KIMI_ALERTS_ENABLED=false
# true = log every outbound message instead of sending it
KIMI_DRY_RUN=true
# Base URL for links in texts. Falls back to NEXT_PUBLIC_BASE_URL, then https://www.kahfcapital.com
KIMI_PUBLIC_BASE_URL=
# 32-byte key (base64 or hex) for phone encryption at rest. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KIMI_PHONE_ENCRYPTION_KEY=
# Optional: use BullMQ on Redis for the inbound queue (also run `npm install bullmq`).
# Without it, the queue lives in Firestore (kimi_jobs).
REDIS_URL=

# --- Jobs and admin ----------------------------------------------------------
# Bearer secret for /api/kimi/jobs/tick and /api/kimi/jobs/rollup (Vercel Cron sends CRON_SECRET)
CRON_SECRET=
# Alternative secret for an external scheduler
KIMI_CRON_SECRET=
# Comma-separated emails allowed into /admin/kimi
ADMIN_EMAILS=
# Optional server-to-server admin bearer token (shared with existing admin routes)
ADMIN_SECRET=

# --- Optional tuning ---------------------------------------------------------
KIMI_SUPPORT_EMAIL=info@kahfcapital.com
# true = only Pro subscribers can enable texts
KIMI_REQUIRE_PRO=false
KIMI_DAILY_TOKEN_CAP=250000
KIMI_DAILY_COST_CAP_USD=2
KIMI_GLOBAL_SPEND_ALERT_USD=50
# Optional Slack-compatible webhook that receives the daily spend alert
KIMI_SPEND_ALERT_WEBHOOK_URL=
KIMI_BACKTESTS_PER_DAY=15
KIMI_BACKTESTS_CONCURRENT=2
# Message retention (days) recorded on every message; no app code deletes messages
KIMI_MESSAGE_RETENTION_DAYS=2555
# firestore | file | memory. Default: firestore in production, data/kimi-dev-store.json in dev
KIMI_STORE=
KIMI_STORE_FILE=
# Development only (ignored when NODE_ENV=production): header-based identity, mock provider
KIMI_DEV_AUTH=true
KIMI_ENABLE_MOCK_PROVIDER=false
KIMI_MOCK_WEBHOOK_SECRET=

# --- Existing services Kimi reads from ---------------------------------------
# Firebase Admin: Kimi's Firestore collections and ID-token checks.
# Set one of: FIREBASE_SERVICE_ACCOUNT_BASE64, FIREBASE_SERVICE_ACCOUNT_KEY (JSON),
# or the three FIREBASE_ADMIN_* values.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Firebase client config (sign-in on /kimi and /admin/kimi)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Backend signal output (reads/*.json) and the dark pool tape
BLOB_READ_WRITE_TOKEN=
# Prices, options quotes and backtest history
POLYGON_API_KEY=
